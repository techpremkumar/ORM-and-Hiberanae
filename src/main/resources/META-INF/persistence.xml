<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="orm-practice">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.example.Customer</class>
        <class>org.example.Order</class>
        <class>EmbeddedDemo.Customer</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/orm_table_per_class"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="NewPass@123"/>

            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <property name="hibernate.cache.use_second_level_cache"
                      value="true"/>

            <property name="hibernate.cache.region.factory_class"
                      value="org.hibernate.cache.jcache.internal.JCacheRegionFactory"/>

            <property name="hibernate.javax.cache.provider"
                      value="org.ehcache.jsr107.EhcacheCachingProvider"/>

            <property name="hibernate.generate_statistics"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>
